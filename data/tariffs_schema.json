{
  "$defs": {
    "DimensionType": {
      "enum": [
        "energy",
        "time",
        "flat",
        "parking"
      ],
      "title": "DimensionType",
      "type": "string"
    },
    "Network": {
      "properties": {
        "network_id": {
          "title": "Network Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "cashback": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cashback"
        },
        "included_cpos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Included Cpos"
        },
        "excluded_cpos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Cpos"
        },
        "included_locations": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Included Locations"
        },
        "excluded_locations": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Locations"
        },
        "tariffs": {
          "items": {
            "$ref": "#/$defs/Tariff"
          },
          "title": "Tariffs",
          "type": "array"
        }
      },
      "required": [
        "network_id",
        "tariffs"
      ],
      "title": "Network",
      "type": "object"
    },
    "PaymentMethod": {
      "enum": [
        "ADHOC",
        "ADHOC_BANK_CARD",
        "RFID_CARD",
        "APP"
      ],
      "title": "PaymentMethod",
      "type": "string"
    },
    "Plan": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "byoe": {
          "default": false,
          "title": "Byoe",
          "type": "boolean"
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "months": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Months"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "payment_methods": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PaymentMethod"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Methods"
        },
        "cycle": {
          "anyOf": [
            {
              "enum": [
                "diario",
                "semanal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle"
        },
        "includes_tar": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includes Tar"
        },
        "includes_iec": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includes Iec"
        },
        "includes_egme": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Includes Egme"
        },
        "activation_fee": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Fee"
        },
        "opc_commission_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opc Commission Pct"
        },
        "renewable_energy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewable Energy"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditions"
        },
        "networks": {
          "items": {
            "$ref": "#/$defs/Network"
          },
          "title": "Networks",
          "type": "array"
        }
      },
      "required": [
        "name",
        "networks"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Provider": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/Plan"
          },
          "title": "Plans",
          "type": "array"
        }
      },
      "required": [
        "name",
        "plans"
      ],
      "title": "Provider",
      "type": "object"
    },
    "RegulatedFees": {
      "description": "A dated set of regulated fees.",
      "properties": {
        "country_code": {
          "default": "PT",
          "title": "Country Code",
          "type": "string"
        },
        "effective_date": {
          "title": "Effective Date",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "tar_variants": {
          "items": {
            "$ref": "#/$defs/TarVariant"
          },
          "title": "Tar Variants",
          "type": "array"
        },
        "iec": {
          "title": "Iec",
          "type": "number"
        },
        "egme_connection": {
          "title": "Egme Connection",
          "type": "number"
        }
      },
      "required": [
        "effective_date",
        "tar_variants",
        "iec",
        "egme_connection"
      ],
      "title": "RegulatedFees",
      "type": "object"
    },
    "TarPeriodRate": {
      "description": "TAR rate for one time-of-use period.",
      "properties": {
        "period": {
          "$ref": "#/$defs/TariffPeriod"
        },
        "rate": {
          "title": "Rate",
          "type": "number"
        }
      },
      "required": [
        "period",
        "rate"
      ],
      "title": "TarPeriodRate",
      "type": "object"
    },
    "TarVariant": {
      "description": "TAR rates for a specific voltage level and cycle.",
      "properties": {
        "voltage_level": {
          "title": "Voltage Level",
          "type": "string"
        },
        "cycle": {
          "enum": [
            "diario",
            "semanal"
          ],
          "title": "Cycle",
          "type": "string"
        },
        "rates": {
          "items": {
            "$ref": "#/$defs/TarPeriodRate"
          },
          "title": "Rates",
          "type": "array"
        }
      },
      "required": [
        "voltage_level",
        "cycle",
        "rates"
      ],
      "title": "TarVariant",
      "type": "object"
    },
    "Tariff": {
      "properties": {
        "type": {
          "anyOf": [
            {
              "enum": [
                "AC",
                "DC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "unit": {
          "$ref": "#/$defs/DimensionType",
          "default": "energy"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "start_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threshold offset / grace period in minutes before the fee applies",
          "title": "Start After"
        },
        "tiers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TariffTier"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiers"
        },
        "time_restrictions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TimeRestriction"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Restrictions"
        },
        "tou_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/TariffPeriod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Tariff",
      "type": "object"
    },
    "TariffPeriod": {
      "enum": [
        "ponta",
        "cheias",
        "vazio"
      ],
      "title": "TariffPeriod",
      "type": "string"
    },
    "TariffTier": {
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threshold offset / grace period in minutes before the fee applies",
          "title": "Start After"
        }
      },
      "required": [
        "price"
      ],
      "title": "TariffTier",
      "type": "object"
    },
    "TimeRestriction": {
      "properties": {
        "start_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "days_of_week": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days Of Week"
        }
      },
      "title": "TimeRestriction",
      "type": "object"
    }
  },
  "properties": {
    "providers": {
      "items": {
        "$ref": "#/$defs/Provider"
      },
      "title": "Providers",
      "type": "array"
    },
    "regulated_fees": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RegulatedFees"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regulated Fees"
    }
  },
  "required": [
    "providers"
  ],
  "title": "TariffDocument",
  "type": "object"
}
